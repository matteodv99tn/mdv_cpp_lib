---
Checks: "
        modernize-*,
        cppcoreguidelines-*,
        bugprone-*,
        clang-analyzer-*,
        readability-*,
        performance-*,
        misc-*,
        -modernize-use-trailing-return-type,
        -modernize-use-constraints,
        -readability-identifier-length,
        -misc-include-cleaner,
        -readability-inconsistent-declaration-parameter-name,
        -misc-non-private-member-variables-in-classes,
        -cppcoreguidelines-non-private-member-variables-in-classes,
        -bugprone-easily-swappable-parameters,
        -readability-function-cognitive-complexity,
        -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
        -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
        -cppcoreguidelines-avoid-magic-numbers,
        -readability-magic-numbers,
        -readability-math-missing-parentheses,
        -cppcoreguidelines-pro-bounds-constant-array-index,
        -cppcoreguidelines-avoid-const-or-ref-data-members,
        -readability-convert-member-functions-to-static,
        -readability-suspicious-call-argument,
        -misc-static-assert,
        -misc-no-recursion
        "
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)include/'
CheckOptions:
  - { key: readability-braces-around-statements.ShortStatementLines,       value: 2          }
  - { key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor, value: true       }
  - { key: cppcoreguidelines-macro-usage.AllowedRegexp,                    value: '^MDV_'     }
  - { key: readability-identifier-naming.NamespaceCase,                    value: lower_case }
  - { key: readability-identifier-naming.ClassCase,                        value: CamelCase  }
  - { key: readability-identifier-naming.StructCase,                       value: CamelCase  }
  - { key: readability-identifier-naming.TemplateParameterCase,            value: CamelCase  }
  - { key: readability-identifier-naming.FunctionCase,                     value: lower_case }
  - { key: readability-identifier-naming.VariableCase,                     value: lower_case }
  # Single upper-case letters / short tokens used as matrix notation (N, T, Rot, Kxx, D12)
  - { key: readability-identifier-naming.VariableIgnoredRegexp,            value: '^[A-Z][A-Za-z0-9]{0,3}$' }
  - { key: readability-identifier-naming.PrivateMemberPrefix,              value: _          }
  - { key: readability-identifier-naming.ProtectedMemberPrefix,            value: _          }
  - { key: readability-identifier-naming.ClassMemberCase,                  value: lower_case }
  - { key: readability-identifier-naming.PrivateClassMemberPrefix,         value: _          }
  - { key: readability-identifier-naming.ProtectedClassMemberPrefix,       value: _          }
  - { key: readability-identifier-naming.MacroDefinitionCase,              value: UPPER_CASE }
  - { key: readability-identifier-naming.EnumCase,                         value: CamelCase  }
  - { key: readability-identifier-naming.TypeAliasCase,                    value: CamelCase  }
  # Member type names required by the standard library (iterators, traits)
  - { key: readability-identifier-naming.TypeAliasIgnoredRegexp,           value: '^(type|value_type|reference|const_reference|pointer|const_pointer|iterator|const_iterator|difference_type|size_type|iterator_category|element_type)$' }
...
