#include "mdv/config.hpp"

namespace mdv::config {

using path = std::filesystem::path;

path
meshes_directory() {
    return path{"@CMAKE_CURRENT_SOURCE_DIR@"} / "data" / "meshes";
}

path
letter_dataset_directory() {
    return path{"@CMAKE_CURRENT_SOURCE_DIR@"} / "data" / "letter_dataset";
}

}  // namespace mdv::config
