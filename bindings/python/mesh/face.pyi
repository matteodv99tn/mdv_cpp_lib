from __future__ import annotations

import numpy as np
from numpy.typing import NDArray

from .mesh import Mesh

class Face:
    def __init__(self, mesh: Mesh, face_id: int) -> None: ...
    @property
    def mesh(self) -> Mesh: ...
    @property
    def id(self) -> int: ...
    @property
    def normal(self) -> NDArray[np.float64]: ...
    def describe(self) -> str: ...
